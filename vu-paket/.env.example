# Адрес и порт процесса (за Caddy/nginx — 127.0.0.1 или 0.0.0.0 в Docker)
VU_HOST=0.0.0.0
VU_PORT=8080
# Публичный адрес сайта: нужен для return_url ЮKassa
VU_PUBLIC_URL=https://vu-paket.example.ru
# За обратным прокси — брать IP клиента из X-Forwarded-For (для ограничения запросов)
VU_TRUST_PROXY=1
VU_DB_PATH=data/vu.db
VU_PRICE_RUB=2490
# Сколько дней хранить неоплаченные анкеты
VU_ORDER_TTL_DAYS=30

# ЮKassa (личный кабинет → Интеграция → Ключи API). Не коммитить!
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Передавать данные для чека (54-ФЗ) — нужно при «Чеках от ЮKassa»
YOOKASSA_RECEIPT=1
# Ставка НДС в чеке: 1 — без НДС. Уточните у бухгалтера под свой налоговый режим.
YOOKASSA_VAT_CODE=1

# Демо-оплата без денег — ТОЛЬКО для локальной проверки, в проде 0
VU_DEMO_PAYMENTS=0

# Реквизиты продавца для оферты и подвала (без них сайт показывает предупреждение)
VU_SELLER_NAME=
VU_SELLER_INN=
VU_SELLER_EMAIL=

# Ключ для /admin?key=... (длинная случайная строка)
VU_ADMIN_KEY=
# Номер счётчика Яндекс Метрики (необязательно; Вебвизор выключен)
VU_METRIKA_ID=
