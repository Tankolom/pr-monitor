{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@static path /static/*
	header @static Cache-Control "public, max-age=604800"
	reverse_proxy web:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
