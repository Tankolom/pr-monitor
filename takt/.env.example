# === Обязательно ===
# ваш домен (без https://), для HTTPS-сертификата
DOMAIN=example.ru
# полный адрес сайта
BASE_URL=https://example.ru
# /admin?token=...
ADMIN_TOKEN=придумайте-длинный-секрет

# === Оплата ===
# mock — тестовая оплата без денег; yookassa — боевая
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ через «Чеки от ЮKassa» (для ИП/ООО). Самозанятым — 0: чек формирует «Мой налог»/ЮKassa.
YOOKASSA_SEND_RECEIPT=0
# 1 = без НДС
YOOKASSA_VAT_CODE=1

# === Цены ===
PRICE_SINGLE=490
PRICE_PACK=1490
PACK_SIZE=5

# === Реквизиты (подставляются в оферту и политику) ===
BRAND=Такт
SELLER_NAME=Иванов Иван Иванович
SELLER_STATUS=самозанятый (плательщик НПД)
SELLER_INN=000000000000
CONTACT_EMAIL=support@example.ru
# например, @takt_support
CONTACT_TELEGRAM=

# === Почта (ссылки на скачивание, коды пакетов). Без неё всё работает, письма просто не уходят ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Такт <support@example.ru>"

# === Аналитика ===
# номер счётчика Яндекс Метрики
METRIKA_ID=

# === Ограничения ===
MAX_UPLOAD_MB=25
FREE_JOBS_PER_HOUR=4
FREE_JOBS_PER_DAY=6
RETENTION_DAYS=7
REBUILDS_PER_ORDER=3
TRUST_PROXY=1

# === Образы Docker ===
# Если с сервера не скачиваются образы с Docker Hub (бывает с российских IP), раскомментируйте:
# BASE_IMAGE=mirror.gcr.io/library/python:3.11-slim
# CADDY_IMAGE=mirror.gcr.io/library/caddy:2
